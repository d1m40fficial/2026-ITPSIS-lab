{
  "name": "2026-itpsis-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:subjects": "python scripts/generate_subject_areas.py",
    "validate": "node scripts/validate-content.mjs",
    "compile:access": "node scripts/compile-access-codes.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint src scripts tests",
    "test": "vitest run",
    "build": "pnpm run validate && pnpm run compile:access && pnpm run typecheck && vite build && node scripts/validate-dist.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "generate:guide": "node scripts/generate-guide.mjs",
    "generate:reports": "python scripts/generate_reports.py"
  },
  "dependencies": {
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
